ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_OAUTH_MODE=authorization_code
ZENDESK_OAUTH_CLIENT_ID=your-client-identifier
ZENDESK_OAUTH_CLIENT_SECRET=your-client-secret
# Optional; defaults to ~/.config/codex-zendesk/client.json
ZENDESK_OAUTH_CLIENT_FILE=
ZENDESK_OAUTH_SCOPE=tickets:read tickets:write users:read organizations:read
# Comma-separated allowlist. Omit to enable all compiled tools.
# ZENDESK_ALLOWED_TOOLS=zendesk_status,zendesk_search_tickets,zendesk_get_ticket
