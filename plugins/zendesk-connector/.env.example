# Zendesk connector configuration.
#
# Every setting the connector reads is listed here. The environment wins over
# the owner-only client file (~/.config/codex-zendesk/client.json) for the
# account and the credentials.
#
# Export what you need, or load the file directly on Node 20.6 or newer:
#
#   node --env-file=.env dist/index.js
#
# Every value below is a placeholder. Never commit a real value.

# --- The account ------------------------------------------------------------

# The account's subdomain. The connector reads
# https://<subdomain>.zendesk.com. A subdomain that starts with http:// or
# https:// is used as the account URL itself.
ZENDESK_SUBDOMAIN=your-subdomain

# The account URL, overriding the subdomain. HTTPS only, except for a local
# host.
# ZENDESK_BASE_URL=https://your-subdomain.zendesk.com

# --- The credentials --------------------------------------------------------

# How the connector authenticates: authorization_code, client_credentials or
# access_token. Unset, the mode in the client file is used.
ZENDESK_OAUTH_MODE=authorization_code

# The OAuth client id and secret of the Zendesk integration.
ZENDESK_OAUTH_CLIENT_ID=your-client-identifier
ZENDESK_OAUTH_CLIENT_SECRET=your-client-secret

# A ready-made access token, for the access_token mode. It is never written
# to a file.
# ZENDESK_OAUTH_ACCESS_TOKEN=your-access-token

# The owner-only files the connector reads and writes. The client file holds
# the account and the credentials, the token file holds the token.
# ZENDESK_OAUTH_CLIENT_FILE=~/.config/codex-zendesk/client.json
# ZENDESK_OAUTH_TOKEN_FILE=~/.config/codex-zendesk/oauth.json

# The scopes the connector asks for. The write scopes are what the write tools
# need; a read-only deployment can leave them out.
ZENDESK_OAUTH_SCOPE=tickets:read tickets:write users:read organizations:read brands:read groups:read

# The port the setup callback listens on while `npm run oauth:setup` runs.
# ZENDESK_OAUTH_CALLBACK_PORT=3219

# --- The tool policy --------------------------------------------------------

# Comma-separated allowlist. Omit to enable all compiled tools.
# Read-only deployments list every read tool:
# ZENDESK_ALLOWED_TOOLS=zendesk_status,zendesk_search_tickets,zendesk_get_ticket,zendesk_list_brands,zendesk_list_groups,zendesk_list_users,zendesk_list_organizations,zendesk_list_ticket_fields,zendesk_list_ticket_forms
# Simpler alternative: serve only the nine read tools.
# ZENDESK_READ_ONLY=1

# --- The transport ----------------------------------------------------------

# How many times a failed request is retried, and how long the connector waits
# between two attempts (milliseconds).
# ZENDESK_MAX_RETRIES=2
# ZENDESK_MAX_RETRY_DELAY_MS=10000

# How long the server waits for a graceful shutdown before it exits anyway
# (milliseconds).
# ZENDESK_SHUTDOWN_TIMEOUT_MS=5000

# --- The shortcuts ----------------------------------------------------------

# Set to 1 to run the healthcheck instead of the server. The command line
# flag --healthcheck does the same.
# ZENDESK_HEALTHCHECK=1
