{
  "name": "@abd-enterprises/zendesk-mcp",
  "version": "0.7.0",
  "description": "OAuth-only MCP server for Zendesk Support ticket workflows.",
  "license": "MIT",
  "author": "ABD Enterprises",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABD-Enterprises/zendesk-mcp.git"
  },
  "homepage": "https://github.com/ABD-Enterprises/zendesk-mcp#readme",
  "bugs": {
    "url": "https://github.com/ABD-Enterprises/zendesk-mcp/issues"
  },
  "keywords": [
    "zendesk",
    "mcp",
    "model-context-protocol",
    "oauth",
    "codex"
  ],
  "type": "module",
  "bin": {
    "zendesk-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:test": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test ./dist/*.test.js",
    "check:tool-tables": "node ../../scripts/generate-tool-tables.mjs --check",
    "test:tool-tables": "node --test ../../scripts/generate-tool-tables.test.mjs",
    "check": "npm run typecheck && npm run check:tool-tables && npm run test:tool-tables && npm test",
    "start": "node ./dist/index.js",
    "doctor": "tsc -p tsconfig.build.json && node ./dist/index.js --doctor",
    "logout": "node ./dist/index.js --logout",
    "healthcheck": "node ./dist/index.js --healthcheck",
    "e2e": "node ./e2e/run-e2e.mjs",
    "e2e:mock": "node --test ./e2e/mock.test.mjs",
    "oauth:setup": "npm run build && node ./dist/oauth-setup.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
